# KQ8: Пошук потужних генеруючих одиниць для передиспатчеризації (Неоптимізований варіант)
# Особливість: декартовий перетин (?gen ?p1 ?o1) x (?substation ?p2 ?o2) та пізній фільтр через REGEX
PREFIX : <http://www.semanticweb.org/ontologies/2026/energy-system#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?gen ?label ?powerMW ?substation
WHERE {
    ?gen ?p1 ?o1 .
    ?substation ?p2 ?o2 .
    ?gen :suppliesPowerTo ?substation .
    ?gen :hasRatedActivePowerMW ?powerMW .
    ?gen rdfs:label ?label .
    FILTER (?powerMW >= 100.0)
    FILTER (REGEX(STR(?substation), "750kV", "i"))
}
