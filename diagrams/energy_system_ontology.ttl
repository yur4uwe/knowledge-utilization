@prefix : <http://www.semanticweb.org/ontologies/2026/energy-system#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cim: <http://iec.ch/TC57/CIM#> .

<http://www.semanticweb.org/ontologies/2026/energy-system> rdf:type owl:Ontology ;
    rdfs:label "Energy System Management Domain Ontology"@en ,
               "Онтологія управління енергетичними системами"@uk ;
    rdfs:comment "OWL 2 Domain Ontology for Energy System Management based on IEC CIM (IEC 61970/62325) for transmission grid dispatching, balancing, and contingency control."@en ;
    owl:versionInfo "1.0.0" .

#################################################################
#    Annotation Properties
#################################################################

cim:iecStandard rdf:type owl:AnnotationProperty .

#################################################################
#    Classes Hierarchy
#################################################################

### Root Concept
:PowerSystemConcept rdf:type owl:Class ;
    rdfs:label "Power System Concept"@en , "Концепт енергетичної системи"@uk ;
    rdfs:comment "Базовий абстрактний клас усіх сутностей енергосистеми."@uk .

### 1. Grid Assets (Фізичні активи)
:GridAsset rdf:type owl:Class ;
    rdfs:subClassOf :PowerSystemConcept ;
    rdfs:label "Grid Asset"@en , "Актив енергосистеми"@uk ;
    cim:iecStandard "cim:IdentifiedObject" .

:GenerationUnit rdf:type owl:Class ;
    rdfs:subClassOf :GridAsset ;
    rdfs:label "Generation Unit"@en , "Генеруюча одиниця"@uk ;
    cim:iecStandard "cim:GeneratingUnit" .

:DispatchableGen rdf:type owl:Class ;
    rdfs:subClassOf :GenerationUnit ;
    rdfs:label "Dispatchable Generation"@en , "Диспетчеризована генерація"@uk .

:NuclearPowerPlant rdf:type owl:Class ;
    rdfs:subClassOf :DispatchableGen ;
    rdfs:label "Nuclear Power Plant"@en , "Атомна електростанція (АЕС)"@uk ;
    cim:iecStandard "cim:NuclearGeneratingUnit" .

:ThermalPowerPlant rdf:type owl:Class ;
    rdfs:subClassOf :DispatchableGen ;
    rdfs:label "Thermal Power Plant"@en , "Теплова електростанція (ТЕС)"@uk ;
    cim:iecStandard "cim:ThermalGeneratingUnit" .

:HydroPowerPlant rdf:type owl:Class ;
    rdfs:subClassOf :DispatchableGen ;
    rdfs:label "Hydro Power Plant"@en , "Гідроелектростанція (ГЕС)"@uk ;
    cim:iecStandard "cim:HydroGeneratingUnit" .

:VREGeneration rdf:type owl:Class ;
    rdfs:subClassOf :GenerationUnit ;
    rdfs:label "Variable Renewable Energy (VRE)"@en , "Стохастична ВДЕ генерація"@uk .

:WindPowerPlant rdf:type owl:Class ;
    rdfs:subClassOf :VREGeneration ;
    rdfs:label "Wind Power Plant"@en , "Вітрова електростанція (ВЕС)"@uk ;
    cim:iecStandard "cim:WindGeneratingUnit" .

:SolarPowerPlant rdf:type owl:Class ;
    rdfs:subClassOf :VREGeneration ;
    rdfs:label "Solar Power Plant"@en , "Сонячна електростанція (СЕС)"@uk ;
    cim:iecStandard "cim:SolarGeneratingUnit" .

:NetworkInfra rdf:type owl:Class ;
    rdfs:subClassOf :GridAsset ;
    rdfs:label "Network Infrastructure"@en , "Мережева інфраструктура"@uk ;
    cim:iecStandard "cim:Equipment" .

:TransmissionLine rdf:type owl:Class ;
    rdfs:subClassOf :NetworkInfra ;
    rdfs:label "Transmission Line"@en , "Магістральна лінія електропередачі"@uk ;
    cim:iecStandard "cim:ACLineSegment" .

:OverheadLine rdf:type owl:Class ;
    rdfs:subClassOf :TransmissionLine ;
    rdfs:label "Overhead Line (OHL)"@en , "Повітряна лінія (ПЛ)"@uk .

:UndergroundCable rdf:type owl:Class ;
    rdfs:subClassOf :TransmissionLine ;
    rdfs:label "Underground Cable Line"@en , "Кабельна лінія (КЛ)"@uk .

:Substation rdf:type owl:Class ;
    rdfs:subClassOf :NetworkInfra ;
    rdfs:label "Substation"@en , "Електрична підстанція"@uk ;
    cim:iecStandard "cim:Substation" .

:PowerTransformer rdf:type owl:Class ;
    rdfs:subClassOf :NetworkInfra ;
    rdfs:label "Power Transformer / Autotransformer"@en , "Силовий автотрансформатор"@uk ;
    cim:iecStandard "cim:PowerTransformer" .

:EnergyStorage rdf:type owl:Class ;
    rdfs:subClassOf :GridAsset ;
    rdfs:label "Energy Storage System"@en , "Система накопичення енергії"@uk ;
    cim:iecStandard "cim:BatteryUnit" .

:BatteryStorageBESS rdf:type owl:Class ;
    rdfs:subClassOf :EnergyStorage ;
    rdfs:label "Battery Energy Storage (BESS)"@en , "Акумуляторна система накопичення (BESS)"@uk .

:PumpedStorageHydro rdf:type owl:Class ;
    rdfs:subClassOf :EnergyStorage ;
    rdfs:label "Pumped Storage Hydro (PSPS)"@en , "Гідроакумулююча станція (ГАЕС)"@uk ;
    cim:iecStandard "cim:HydroPump" .

:EnergyConsumer rdf:type owl:Class ;
    rdfs:subClassOf :GridAsset ;
    rdfs:label "Energy Consumer"@en , "Споживач електроенергії"@uk ;
    cim:iecStandard "cim:EnergyConsumer" .

:IndustrialConsumer rdf:type owl:Class ;
    rdfs:subClassOf :EnergyConsumer ;
    rdfs:label "Industrial Consumer (Demand Response)"@en , "Промисловий споживач з DR"@uk .

:ResidentialConsumer rdf:type owl:Class ;
    rdfs:subClassOf :EnergyConsumer ;
    rdfs:label "Residential Consumer"@en , "Побутовий споживач"@uk .

### 2. System Processes (Системні процеси)
:SystemProcess rdf:type owl:Class ;
    rdfs:subClassOf :PowerSystemConcept ;
    rdfs:label "System Process"@en , "Системний процес"@uk .

:GridBalancingProcess rdf:type owl:Class ;
    rdfs:subClassOf :SystemProcess ;
    rdfs:label "Grid Balancing Process"@en , "Процес балансування частоти та потужності"@uk .

:PrimaryFrequencyControl rdf:type owl:Class ;
    rdfs:subClassOf :GridBalancingProcess ;
    rdfs:label "Primary Frequency Containment Reserve (FCR)"@en , "Первинне регулювання частоти (FCR)"@uk .

:SecondaryFrequencyRestoration rdf:type owl:Class ;
    rdfs:subClassOf :GridBalancingProcess ;
    rdfs:label "Secondary Frequency Restoration Reserve (aFRR)"@en , "Вторинне регулювання частоти (aFRR)"@uk .

:ContingencyProcess rdf:type owl:Class ;
    rdfs:subClassOf :SystemProcess ;
    rdfs:label "Contingency & Emergency Control"@en , "Протиаварійне керування"@uk .

:RelayProtectionAction rdf:type owl:Class ;
    rdfs:subClassOf :ContingencyProcess ;
    rdfs:label "Relay Protection Action"@en , "Дія релейного захисту та автоматики (РЗА)"@uk ;
    cim:iecStandard "cim:ProtectionRelay" .

:RedispatchProcess rdf:type owl:Class ;
    rdfs:subClassOf :ContingencyProcess ;
    rdfs:label "Redispatching Process"@en , "Процес передиспатчеризації потужності"@uk ;
    cim:iecStandard "cim:RemedialActionScheme" .

:DiagnosticProcess rdf:type owl:Class ;
    rdfs:subClassOf :SystemProcess ;
    rdfs:label "Diagnostic & Maintenance Process"@en , "Процес технічної діагностики"@uk .

:DissolvedGasAnalysis rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticProcess ;
    rdfs:label "Dissolved Gas Analysis (DGA)"@en , "Хроматографічний аналіз розчинених газів (АРГ)"@uk ;
    cim:iecStandard "cim:ConditionAssessment" .

### 3. System Events & Disturbances (Події та збурення)
:SystemEvent rdf:type owl:Class ;
    rdfs:subClassOf :PowerSystemConcept ;
    rdfs:label "System Event & Disturbance"@en , "Системна подія та збурення"@uk .

:GridFault rdf:type owl:Class ;
    rdfs:subClassOf :SystemEvent ;
    rdfs:label "Grid Physical Fault"@en , "Фізичне пошкодження мережі"@uk ;
    cim:iecStandard "cim:Fault" .

:ShortCircuitFault rdf:type owl:Class ;
    rdfs:subClassOf :GridFault ;
    rdfs:label "Short Circuit Fault"@en , "Коротке замикання (КЗ)"@uk .

:OperationalViolation rdf:type owl:Class ;
    rdfs:subClassOf :SystemEvent ;
    rdfs:label "Operational Violation"@en , "Режимне порушення параметрів"@uk ;
    cim:iecStandard "cim:OperationalLimitViolation" .

:LineOverload rdf:type owl:Class ;
    rdfs:subClassOf :OperationalViolation ;
    rdfs:label "Transmission Line Overload (N-1)"@en , "Струмове перевантаження лінії"@uk .

:FrequencyDeviation rdf:type owl:Class ;
    rdfs:subClassOf :OperationalViolation ;
    rdfs:label "Grid Frequency Deviation"@en , "Відхилення частоти мережі"@uk .

:EquipmentDefect rdf:type owl:Class ;
    rdfs:subClassOf :SystemEvent ;
    rdfs:label "Equipment Defect"@en , "Внутрішній дефект обладнання"@uk .

:InsulationDegradation rdf:type owl:Class ;
    rdfs:subClassOf :EquipmentDefect ;
    rdfs:label "Transformer Insulation Degradation"@en , "Деградація паперово-масляної ізоляції"@uk .

### 4. System Actors (Суб'єкти керування)
:SystemActor rdf:type owl:Class ;
    rdfs:subClassOf :PowerSystemConcept ;
    rdfs:label "System Actor"@en , "Системний актор / суб'єкт"@uk .

:TransmissionSystemOperator rdf:type owl:Class ;
    rdfs:subClassOf :SystemActor ;
    rdfs:label "Transmission System Operator (TSO)"@en , "Оператор системи передачі (ОСП)"@uk ;
    cim:iecStandard "cim:ControlArea" .

:ControlCenterDispatcher rdf:type owl:Class ;
    rdfs:subClassOf :SystemActor ;
    rdfs:label "SCADA/EMS Dispatcher"@en , "Диспетчерський персонал SCADA/EMS"@uk .

:BalanceResponsibleParty rdf:type owl:Class ;
    rdfs:subClassOf :SystemActor ;
    rdfs:label "Balance Responsible Party (BRP)"@en , "Сторона, відповідальна за баланс (СВБ)"@uk .

### Defined / Inferred Class (Демонстрація інференції Reasoner)
:HighVoltageEquipment rdf:type owl:Class ;
    rdfs:label "High Voltage Equipment (>= 330 kV)"@en , "Високовольтне обладнання (>= 330 кВ)"@uk ;
    rdfs:subClassOf :NetworkInfra ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :NetworkInfra
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasVoltageLevelKV ;
              owl:someValuesFrom [
                  rdf:type rdfs:Datatype ;
                  owl:onDatatype xsd:double ;
                  owl:withRestrictions ( [ xsd:minInclusive 330.0 ] )
              ]
            ]
        )
    ] ;
    rdfs:comment "Клас, екземпляри якого автоматично виводяться Reasoner-ом на основі номінальної напруги >= 330 кВ."@uk .

#################################################################
#    Disjoint Classes Axioms
#################################################################

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( :GridAsset :SystemProcess :SystemEvent :SystemActor ) .

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( :GenerationUnit :NetworkInfra :EnergyStorage :EnergyConsumer ) .

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( :DispatchableGen :VREGeneration ) .

[] rdf:type owl:AllDisjointClasses ;
   owl:members ( :TransmissionLine :Substation :PowerTransformer ) .

#################################################################
#    Object Properties
#################################################################

:suppliesPowerTo rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :GenerationUnit :EnergyStorage ) ] ;
    rdfs:range :Substation ;
    owl:inverseOf :receivesPowerFrom ;
    rdfs:label "supplies power to"@en , "видає потужність на"@uk .

:receivesPowerFrom rdf:type owl:ObjectProperty ;
    rdfs:domain :Substation ;
    rdfs:range [ rdf:type owl:Class ; owl:unionOf ( :GenerationUnit :EnergyStorage ) ] ;
    owl:inverseOf :suppliesPowerTo ;
    rdfs:label "receives power from"@en , "приймає потужність від"@uk .

:connectedTo rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain :NetworkInfra ;
    rdfs:range :NetworkInfra ;
    rdfs:label "connected to"@en , "електрично з'єднаний з"@uk .

:partOf rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain :PowerSystemConcept ;
    rdfs:range :PowerSystemConcept ;
    owl:inverseOf :hasPart ;
    rdfs:label "part of"@en , "є складовою частиною"@uk .

:hasPart rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain :PowerSystemConcept ;
    rdfs:range :PowerSystemConcept ;
    owl:inverseOf :partOf ;
    rdfs:label "has part"@en , "містить у своєму складі"@uk .

:monitors rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :SystemActor :SystemProcess ) ] ;
    rdfs:range [ rdf:type owl:Class ; owl:unionOf ( :GridAsset :SystemEvent ) ] ;
    owl:inverseOf :isMonitoredBy ;
    rdfs:label "monitors"@en , "здійснює моніторинг"@uk .

:isMonitoredBy rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :GridAsset :SystemEvent ) ] ;
    rdfs:range [ rdf:type owl:Class ; owl:unionOf ( :SystemActor :SystemProcess ) ] ;
    owl:inverseOf :monitors ;
    rdfs:label "is monitored by"@en , "контролюється"@uk .

:triggers rdf:type owl:ObjectProperty ;
    rdfs:domain :SystemEvent ;
    rdfs:range :SystemProcess ;
    owl:inverseOf :isTriggeredBy ;
    rdfs:label "triggers"@en , "ініціює запуск процесу"@uk .

:isTriggeredBy rdf:type owl:ObjectProperty ;
    rdfs:domain :SystemProcess ;
    rdfs:range :SystemEvent ;
    owl:inverseOf :triggers ;
    rdfs:label "is triggered by"@en , "викликаний подією"@uk .

:protects rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :RelayProtectionAction :DiagnosticProcess ) ] ;
    rdfs:range :NetworkInfra ;
    rdfs:label "protects"@en , "захищає від руйнування"@uk .

:operates rdf:type owl:ObjectProperty ;
    rdfs:domain :SystemActor ;
    rdfs:range :SystemProcess ;
    rdfs:label "operates"@en , "керує виконанням процесу"@uk .

:regulates rdf:type owl:ObjectProperty ;
    rdfs:domain :SystemProcess ;
    rdfs:range [ rdf:type owl:Class ; owl:unionOf ( :GridAsset :SystemEvent ) ] ;
    rdfs:label "regulates"@en , "регулює параметри"@uk .

:causes rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :SystemEvent :SystemProcess ) ] ;
    rdfs:range :SystemEvent ;
    rdfs:label "causes"@en , "спричиняє настання"@uk .

:activates rdf:type owl:ObjectProperty ;
    rdfs:domain :SystemProcess ;
    rdfs:range :GridAsset ;
    rdfs:label "activates"@en , "активує дію активу"@uk .

#################################################################
#    Data Properties
#################################################################

:hasRatedActivePowerMW rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :GridAsset ;
    rdfs:range xsd:double ;
    rdfs:label "has rated active power (MW)"@en , "номінальна активна потужність (МВт)"@uk .

:hasVoltageLevelKV rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :NetworkInfra :GridAsset ) ] ;
    rdfs:range xsd:double ;
    rdfs:label "has voltage level (kV)"@en , "клас номінальної напруги (кВ)"@uk .

:hasGridFrequencyHz rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :FrequencyDeviation ;
    rdfs:range xsd:double ;
    rdfs:label "has grid frequency (Hz)"@en , "фактична частота мережі (Гц)"@uk .

:hasFaultCurrentKA rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :ShortCircuitFault ;
    rdfs:range xsd:double ;
    rdfs:label "has fault current (kA)"@en , "струм короткого замикання (кА)"@uk .

:hasOperatingStatus rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :GridAsset ;
    rdfs:range xsd:string ;
    rdfs:label "has operating status"@en , "експлуатаційний стан"@uk .

:hasTripTimeMS rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :RelayProtectionAction ;
    rdfs:range xsd:integer ;
    rdfs:label "has trip time (ms)"@en , "час спрацювання РЗА (мс)"@uk .

:hasHydrogenConcentrationPPM rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :DissolvedGasAnalysis ;
    rdfs:range xsd:double ;
    rdfs:label "has hydrogen H2 (ppm)"@en , "концентрація водню H2 (ppm)"@uk .

:hasAcetyleneConcentrationPPM rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :DissolvedGasAnalysis ;
    rdfs:range xsd:double ;
    rdfs:label "has acetylene C2H2 (ppm)"@en , "концентрація ацетилену C2H2 (ppm)"@uk .

:hasAssetIdentifier rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :PowerSystemConcept ;
    rdfs:range xsd:string ;
    rdfs:label "asset identifier (CIM mRID)"@en , "системний ідентифікатор CIM"@uk .

#################################################################
#    Named Individuals (Instances)
#################################################################

### Generation Units
:KhmelnytskyiNPP_Unit1 rdf:type owl:NamedIndividual , :NuclearPowerPlant ;
    :hasAssetIdentifier "UA-GEN-KNPP-01" ;
    :hasRatedActivePowerMW 1000.0 ;
    :hasVoltageLevelKV 750.0 ;
    :hasOperatingStatus "IN_SERVICE_BASELOAD" ;
    :suppliesPowerTo :Substation_Zakhidnoukrainska_750kV ;
    rdfs:label "Хмельницька АЕС, Енергоблок №1"@uk .

:Pokrovska_Solar_SES rdf:type owl:NamedIndividual , :SolarPowerPlant ;
    :hasAssetIdentifier "UA-GEN-SES-POKR" ;
    :hasRatedActivePowerMW 240.0 ;
    :hasVoltageLevelKV 330.0 ;
    :hasOperatingStatus "IN_SERVICE_VARIABLE" ;
    :suppliesPowerTo :Substation_Vinnytska_750kV ;
    rdfs:label "Покровська СЕС (240 МВт)"@uk .

:Dniester_PSPS_Unit rdf:type owl:NamedIndividual , :PumpedStorageHydro ;
    :hasAssetIdentifier "UA-GEN-PSPS-DNIEST" ;
    :hasRatedActivePowerMW 324.0 ;
    :hasVoltageLevelKV 330.0 ;
    :hasOperatingStatus "STANDBY_SPINNING_RESERVE" ;
    :suppliesPowerTo :Substation_Vinnytska_750kV ;
    rdfs:label "Дністровська ГАЕС, Гідроагрегат №1"@uk .

### Network Infrastructure
:Substation_Zakhidnoukrainska_750kV rdf:type owl:NamedIndividual , :Substation ;
    :hasAssetIdentifier "UA-SUBST-ZAKH-750" ;
    :hasVoltageLevelKV 750.0 ;
    :hasOperatingStatus "ENERGIZED_OPERATIONAL" ;
    :connectedTo :OverheadLine_Zakhidna_Vinnytska_750kV ;
    :hasPart :Autotransformer_AT1_Zakhidna ;
    rdfs:label "ПС 750 кВ «Західноукраїнська»"@uk .

:Substation_Vinnytska_750kV rdf:type owl:NamedIndividual , :Substation ;
    :hasAssetIdentifier "UA-SUBST-VINN-750" ;
    :hasVoltageLevelKV 750.0 ;
    :hasOperatingStatus "ENERGIZED_OPERATIONAL" ;
    :connectedTo :OverheadLine_Zakhidna_Vinnytska_750kV ;
    rdfs:label "ПС 750 кВ «Вінницька»"@uk .

:OverheadLine_Zakhidna_Vinnytska_750kV rdf:type owl:NamedIndividual , :OverheadLine ;
    :hasAssetIdentifier "UA-OHL-750-ZV" ;
    :hasVoltageLevelKV 750.0 ;
    :hasOperatingStatus "IN_SERVICE_TRANSMITTING" ;
    :connectedTo :Substation_Zakhidnoukrainska_750kV , :Substation_Vinnytska_750kV ;
    rdfs:label "ПЛ 750 кВ Західноукраїнська — Вінницька"@uk .

:Autotransformer_AT1_Zakhidna rdf:type owl:NamedIndividual , :PowerTransformer ;
    :hasAssetIdentifier "UA-TR-AT1-ZAKH" ;
    :hasVoltageLevelKV 750.0 ;
    :hasRatedActivePowerMW 1000.0 ;
    :hasOperatingStatus "IN_SERVICE_LOADED" ;
    :partOf :Substation_Zakhidnoukrainska_750kV ;
    rdfs:label "Автотрансформатор АТ-1 750/330 кВ (ПС Західноукраїнська)"@uk .

### Consumers
:Lviv_Industrial_Consumer rdf:type owl:NamedIndividual , :IndustrialConsumer ;
    :hasAssetIdentifier "UA-LOAD-LVIV-IND" ;
    :hasRatedActivePowerMW 180.0 ;
    :hasVoltageLevelKV 110.0 ;
    :hasOperatingStatus "LOAD_ACTIVE_DR_ENABLED" ;
    rdfs:label "Львівський промисловий енерговузол (DR)"@uk .

### System Actors
:Ukrenergo_National_TSO rdf:type owl:NamedIndividual , :TransmissionSystemOperator ;
    :hasAssetIdentifier "UA-ACTOR-TSO-UKRENERGO" ;
    :operates :Redispatch_Contingency_Process ;
    :monitors :OverheadLine_Zakhidna_Vinnytska_750kV ;
    rdfs:label "НЕК «Укренерго» — ОСП України"@uk .

:Dispatcher_Duty_Shift rdf:type owl:NamedIndividual , :ControlCenterDispatcher ;
    :hasAssetIdentifier "UA-ACTOR-DISP-CENTRAL" ;
    :operates :FCR_Primary_Frequency_Response ;
    :monitors :Frequency_Drop_Event_50Hz ;
    rdfs:label "Черговий диспетчер ЦДП ОЕС України"@uk .

### Events & Disturbances
:ShortCircuit_Fault_Line750 rdf:type owl:NamedIndividual , :ShortCircuitFault ;
    :hasAssetIdentifier "EVT-2026-FAULT-SC-01" ;
    :hasFaultCurrentKA 24.5 ;
    :causes :Line_Overload_Vinnytska_330kV ;
    :triggers :RelayProtection_Trip_Line750 ;
    rdfs:label "Двофазне КЗ на ПЛ 750 кВ (грозове перекриття)"@uk .

:Line_Overload_Vinnytska_330kV rdf:type owl:NamedIndividual , :LineOverload ;
    :hasAssetIdentifier "EVT-2026-OVLD-330" ;
    :triggers :Redispatch_Contingency_Process ;
    rdfs:label "Струмове перевантаження суміжної ПЛ 330 кВ (критерій N-1)"@uk .

:Frequency_Drop_Event_50Hz rdf:type owl:NamedIndividual , :FrequencyDeviation ;
    :hasAssetIdentifier "EVT-2026-FREQ-DROP" ;
    :hasGridFrequencyHz 49.88 ;
    :triggers :FCR_Primary_Frequency_Response ;
    rdfs:label "Частотна аварійна подія: спад f до 49.88 Гц"@uk .

:Insulation_Defect_AT1 rdf:type owl:NamedIndividual , :InsulationDegradation ;
    :hasAssetIdentifier "EVT-2026-DEFECT-DGA-AT1" ;
    :triggers :DGA_Oil_Diagnostic_AT1 ;
    rdfs:label "Теплова деструкція діелектрика в баку АТ-1"@uk .

### Processes
:RelayProtection_Trip_Line750 rdf:type owl:NamedIndividual , :RelayProtectionAction ;
    :hasAssetIdentifier "PROC-PROT-TRIP-750" ;
    :hasTripTimeMS 65 ;
    :protects :OverheadLine_Zakhidna_Vinnytska_750kV ;
    rdfs:label "Спрацювання ДФЗ захисту ПЛ 750 кВ за 65 мс"@uk .

:Redispatch_Contingency_Process rdf:type owl:NamedIndividual , :RedispatchProcess ;
    :hasAssetIdentifier "PROC-REDISP-N1-OPT" ;
    :regulates :KhmelnytskyiNPP_Unit1 ;
    rdfs:label "Протиаварійне розвантаження/передиспатчеризація N-1"@uk .

:FCR_Primary_Frequency_Response rdf:type owl:NamedIndividual , :PrimaryFrequencyControl ;
    :hasAssetIdentifier "PROC-BAL-FCR-01" ;
    :activates :Dniester_PSPS_Unit ;
    :regulates :Frequency_Drop_Event_50Hz ;
    rdfs:label "Активація резерву первинного регулювання FCR (ГАЕС)"@uk .

:DGA_Oil_Diagnostic_AT1 rdf:type owl:NamedIndividual , :DissolvedGasAnalysis ;
    :hasAssetIdentifier "PROC-DIAG-DGA-AT1" ;
    :hasHydrogenConcentrationPPM 145.0 ;
    :hasAcetyleneConcentrationPPM 12.4 ;
    :protects :Autotransformer_AT1_Zakhidna ;
    :monitors :Insulation_Defect_AT1 ;
    rdfs:label "Хроматографічний аналіз трансформаторного масла АТ-1"@uk .
