PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX bd: <http://www.bigdata.com/rdf#>

SELECT ?country ?countryLabel (COUNT(?plant) AS ?plantCount) WHERE {
  VALUES ?country { wd:Q212 wd:Q142 wd:Q183 wd:Q36 wd:Q28 wd:Q218 wd:Q29 wd:Q38 }
  ?plant wdt:P31/wdt:P279* wd:Q134447 ;
         wdt:P17 ?country .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "uk,en". }
}
GROUP BY ?country ?countryLabel
HAVING (COUNT(?plant) >= 2)
ORDER BY DESC(?plantCount)
